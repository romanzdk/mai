{
  "name": "mai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-node.mjs && node scripts/fetch-browser.mjs",
    "dev": "pnpm --filter @mai/daemon build && pnpm --filter @mai/shell tauri dev",
    "build": "node scripts/bundle-daemon.mjs && pnpm --filter @mai/shell tauri build --config src-tauri/tauri.release.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mai/daemon build && pnpm --filter @mai/shell e2e",
    "app:install": "node scripts/install-app.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
